# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Owner login password, stored as a bcrypt hash (never store the raw password).
# Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
OWNER_PASSWORD_HASH=

# Random signing secret for owner session cookies (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL used to build shareable links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
