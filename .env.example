# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
# Everything below except the two app secrets is written for you by
# azure/infra.sh into azure/.env.azure — copy the values across, or let
# azure/deploy-local.sh read both files.

# PostgreSQL. Azure Database for PostgreSQL always requires TLS.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-SERVER.postgres.database.azure.com:5432/anurupa?sslmode=require

# Azure Blob Storage, for profile photos and journey media. Both containers
# are private; the app mints a one-hour SAS URL per render.
# Key: az storage account keys list -g anurupa-rg -n YOUR-ACCOUNT --query "[0].value" -o tsv
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# Admin login password, stored as a bcrypt hash (never store the raw password).
# Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# IMPORTANT: escape every $ as \$ below - Next.js expands unescaped $VAR
# references in .env files, which silently corrupts bcrypt hashes otherwise.
ADMIN_PASSWORD_HASH=

# Random signing secret for owner session cookies (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL used to build shareable links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
